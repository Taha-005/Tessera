# Copy this file to .env (git-ignored) and replace every placeholder. Never commit .env.

# Required
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/tessera
DATA_DIR=/path/to/tessera-data
# Generate one with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=

# Optional
# Browser origins allowed to call the API, as a JSON list (the frontend dev server, TESS-14).
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
# Stays optional until O-12 (LLM provider) is decided.
LLM_API_KEY=
